{
  "schema_version": 1,
  "id": "SPIDER-TIME-CAPSULE",
  "purpose": "preserve authentic founder context across generations",
  "preserve": [
    "authenticated_voice",
    "authenticated_video",
    "written_messages",
    "selected_project_history",
    "armor_g0_origin",
    "spider_engine_origin",
    "historical_technology_context"
