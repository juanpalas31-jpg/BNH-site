{
  "schema_version": 1,
  "principle": "The physical Vault creates presence; the digital lineage preserves continuity.",
  "physical": [
    "building",
    "ceremony_room",
    "archive_hardware",
    "display_and_audio",
    "optional_armor_artifacts"
  ],
  "digital": [
    "spider_dna",
    "egg_manifests",
    "integrity_proofs",
    "founder_media_refs",
