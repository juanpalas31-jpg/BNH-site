{
  "schema_version": 1,
  "ceremony_id": "SPIDER-HATCH-CEREMONY-V1",
  "principle": "cinematic_but_authentic",
  "states": [
    "dormant",
    "recipient_recognition",
    "authorization",
    "awakening",
    "personal_greeting",
    "founder_message",
    "hatch",
    "spider_bonding",
